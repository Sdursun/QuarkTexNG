# Copy to tests/settings.local.psd1 (not committed) and adjust the paths.
@{
	# WinUAE installation with a 32-bit winuae.exe and "Amiga Programs\UAEquit"
	WinUAEDir = 'C:\WinUAE'
	# Kickstart ROM for an A1200 (3.1 or later)
	Kickstart = 'C:\WinUAE\Roms\kick.rom'
	# Bootable AmigaOS hard file with RTG (Picasso96/uaegfx); mounted read-only
	HardFile  = 'C:\WinUAE\HardFile\System.hdf'
}
